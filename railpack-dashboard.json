{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "aptPackages": ["libatomic1"],
  "steps": {
    "install": {
      "inputs": ["...", { "local": true, "include": ["."] }],
      "commands": ["pnpm install"]
    },
    "build": {
      "inputs": [{ "step": "install" }],
      "commands": ["pnpm run build"]
    }
  },
  "deploy": {
    "startCommand": "pnpm start"
  }
}

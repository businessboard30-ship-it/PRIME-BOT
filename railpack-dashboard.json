   {
     "$schema": "https://schema.railpack.com",
     "provider": "node",
     "steps": {
       "install": {
         "commands": ["pnpm install"]
       },
       "build": {
         "inputs": [{ "step": "install" }],
         "commands": ["pnpm run build"]
       }
     },
     "deploy": {
       "startCommand": "pnpm start"
     }
   }

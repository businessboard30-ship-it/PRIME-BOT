# Railway API domain (api_server.py) — NOT the Next.js dashboard domain.
NEXT_PUBLIC_BOT_API_BASE=https://your-api-service.up.railway.app
# Same value as config.py's DISCORD_SUPPORT_SERVER_INVITE.
NEXT_PUBLIC_SUPPORT_SERVER_INVITE=
# Main dashboard site, for the "Return home" link.
NEXT_PUBLIC_MAIN_SITE_URL=https://dash-production-c237.up.railway.app
# Only set if deploying as a GitHub Pages PROJECT page (username.github.io/REPO/).
# Leave unset for a user/org page or a custom domain.
BASE_PATH=
